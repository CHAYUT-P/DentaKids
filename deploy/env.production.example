# ─────────────────────────────────────────────────────────────────────────────
# Denta Kids — production settings for the VPS.
# Copy to deploy/.env.production on your Mac, fill it in, then run:
#   pnpm deploy:vps root@<server-ip>
# This file holds secrets: it is git-ignored and only copied to the server.
# ─────────────────────────────────────────────────────────────────────────────

# Your domain, already pointing (DNS "A" record) at the server's IP.
# LINE needs HTTPS, so a domain is required for the LINE booking to work.
# Just trying it out? Use the free name made from the server's IP — no DNS
# needed: for 140.245.12.34 write  DOMAIN=140-245-12-34.sslip.io
DOMAIN=booking.example.com

# Database password for the server's own Postgres — make up a long random one.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Staff app PIN (same as now) and the secret the reminder timer uses.
STAFF_PIN=
CRON_SECRET=change-me-random

# LINE (copy from the current Vercel / .env settings)
NEXT_PUBLIC_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Error alerts on LINE (optional): your own LINE user id. Send "myid" to the
# clinic's LINE OA and it replies with it (starts with U…).
ALERT_LINE_USER_ID=

# Live updates for the staff screens (docs/design/04-live-updates.md). On this
# server a stream can stay open for an hour; "off" falls back to 20 s polling.
SSE_STREAM_SECONDS=3600
STAFF_LIVE_UPDATES=on

# Which screens every staff app shows (queue | full) — the desktop app and the
# web console both follow this. Moving the clinic to the full edition is
# changing this line and restarting; nothing is reinstalled on the PCs.
STAFF_EDITION=queue

# One time only: copy everything from the current database (e.g. Neon) into
# the server on the first deploy. Leave empty to start empty.
COPY_FROM_DATABASE_URL=
