{
  "name": "dentalweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "db:test": "tsx --import ./scripts/shimServerOnly.ts scripts/dbTest.ts",
    "db:studio": "drizzle-kit studio",
    "e2e:test": "tsx --import ./scripts/shimServerOnly.ts scripts/e2eTest.ts",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "concurrency:test": "tsx --import ./scripts/shimServerOnly.ts scripts/concurrencyTest.ts"
  },
  "dependencies": {
    "@line/liff": "2.31.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "server-only": "^0.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
