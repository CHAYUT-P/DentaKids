{
  "compilerOptions": {
    "target": "ES2021",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/server/actions": [
        "./src/api.ts"
      ],
      "@/lib/staffEventsConnect": [
        "./src/staffEventsConnect.ts"
      ],
      "@/components/staff/StaffSidebar": [
        "./src/components/StaffSidebar.tsx"
      ],
      "@/*": [
        "../../src/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../../src/app/staff",
    "../../src/components/staff",
    "../../src/lib/staffStore.tsx"
  ]
}
