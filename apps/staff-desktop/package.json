{
  "name": "staff-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Denta Kids staff console — standalone desktop app (bundled UI, calls /api/staff)",
  "scripts": {
    "dev": "vite",
    "dev:full": "vite --mode full",
    "dev:app": "tauri dev",
    "dev:app:full": "tauri dev --config src-tauri/tauri.full.conf.json",
    "build": "vite build",
    "build:full": "vite build --mode full",
    "typecheck": "tsc --noEmit",
    "build:app": "tauri build",
    "build:app:full": "tauri build --config src-tauri/tauri.full.conf.json"
  },
  "dependencies": {
    "@fontsource/mitr": "^5.3.0",
    "@fontsource/prompt": "^5.3.0",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "typescript": "^5",
    "vite": "^6"
  }
}
