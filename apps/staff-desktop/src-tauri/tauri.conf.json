{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Denta Kids Staff",
  "version": "0.1.0",
  "identifier": "com.dentakids.staff",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Denta Kids \u2014 Staff",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:3000 http://localhost:5173 ws://localhost:5173; img-src 'self' data: blob: https:; media-src 'self' blob: mediastream:; frame-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMjgzQjc3MTkyMjk2ODYKUldTR2xpSVpkenNvcnVFd1BXT1JuZTVDSk5RMlJ3TkVUbUZCWGpDdlpUYnE2WUhjT21UU2ZrN1IK",
      "endpoints": [
        "https://raw.githubusercontent.com/CHAYUT-P/DentaKids-releases/main/queue/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
